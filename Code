import tkinter as tk
from tkinter import messagebox
import os
import shutil

def reset_time_limit():
   
    username = os.getlogin()
    
    target_folder = rf'C:\Users\{username}\AppData\Roaming\WeMod\Local Storage\leveldb'

    try:
        if os.path.exists(target_folder):
            shutil.rmtree(target_folder)
            messagebox.showinfo("Success", "Time limit has been reset. Restart your wemod!")
        else:
            messagebox.showerror("Error", "Folder 'leveldb' not found in the specified location.")
    except Exception as e:
        messagebox.showerror("Error", f"An error occurred while deleting the folder: {e}")


root = tk.Tk()
root.title("WeMod Time Reset")
root.geometry("400x200")
root.resizable(False, False)


frame = tk.Frame(root)
frame.pack(expand=True)


label = tk.Label(frame, text="Before you use this software close your wemod completely.",
                 wraplength=350, justify="center", font=("Arial", 10))
label.pack(pady=(0, 20))


reset_button = tk.Button(frame, text="Reset time limit.",
                         command=reset_time_limit,
                         font=("Arial", 12, "bold"),
                         bg="#4CAF50", fg="white",
                         padx=20, pady=10)
reset_button.pack()

root.mainloop()
